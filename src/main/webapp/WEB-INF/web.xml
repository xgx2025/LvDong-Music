<!DOCTYPE web-app PUBLIC
 "-//Sun Microsystems, Inc.//DTD Web Application 2.3//EN"
 "http://java.sun.com/dtd/web-app_2_3.dtd" >

<web-app>
  <display-name>Archetype Created Web Application</display-name>


  <filter>
    <filter-name>CorsFilter</filter-name>
    <filter-class>filter.CorsFilter</filter-class>
  </filter>
  <filter>
    <filter-name>TokenFilter</filter-name>
    <filter-class>filter.TokenFilter</filter-class>
  </filter>
<!--  <filter>-->
<!--    <filter-name>TransactionFilter</filter-name>-->
<!--    <filter-class>filter.TransactionFilter</filter-class>-->
<!--  </filter>-->


  <filter-mapping>
    <filter-name>CorsFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>TokenFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>
<!--  <filter-mapping>-->
<!--    <filter-name>TransactionFilter</filter-name>-->
<!--    <url-pattern>/*</url-pattern>-->
<!--  </filter-mapping>-->




  <servlet>
    <servlet-name>UserServlet</servlet-name>
    <servlet-class>servlet.UserServlet</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>AuthServlet</servlet-name>
    <servlet-class>servlet.AuthServlet</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>HlsStreamingServlet</servlet-name>
    <servlet-class>servlet.HlsStreamingServlet</servlet-class>
    <!-- FFmpeg路径和HLS目录在application.properties中配置 -->
  </servlet>
  <servlet>
    <servlet-name>SearchServlet</servlet-name>
    <servlet-class>servlet.SearchServlet</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>SingerServlet</servlet-name>
    <servlet-class>servlet.SingerServlet</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>MusicServlet</servlet-name>
    <servlet-class>servlet.MusicServlet</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>CommentServlet</servlet-name>
    <servlet-class>servlet.CommentServlet</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>RecognitionServlet</servlet-name>
    <servlet-class>servlet.RecognitionServlet</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>FavoriteServlet</servlet-name>
    <servlet-class>servlet.FavoriteServlet</servlet-class>
  </servlet>



  

  <servlet-mapping>
    <servlet-name>UserServlet</servlet-name>
    <url-pattern>/userServlet</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>AuthServlet</servlet-name>
    <url-pattern>/authServlet</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>HlsStreamingServlet</servlet-name>
    <url-pattern>/hls</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>SearchServlet</servlet-name>
    <url-pattern>/searchServlet</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>SingerServlet</servlet-name>
    <url-pattern>/singerServlet</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>MusicServlet</servlet-name>
    <url-pattern>/musicServlet</url-pattern>
  </servlet-mapping>
<servlet-mapping>
  <servlet-name>CommentServlet</servlet-name>
  <url-pattern>/commentServlet</url-pattern>
</servlet-mapping>
<servlet-mapping>
  <servlet-name>RecognitionServlet</servlet-name>
  <url-pattern>/recognitionServlet</url-pattern>
</servlet-mapping>
<servlet-mapping>
  <servlet-name>FavoriteServlet</servlet-name>
  <url-pattern>/favoriteServlet</url-pattern>
</servlet-mapping>

  <error-page>
    <!-- 错误码：404（页面未找到） -->
    <error-code>404</error-code>
    <!-- 自定义页面路径：相对于Web应用根目录 -->
    <location>/error/404.html</location>
  </error-page>

</web-app>
