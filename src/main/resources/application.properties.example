# WAR 默认排除 application.properties。部署时使用环境变量或 APP_CONFIG_FILE 指向外部配置。
# ==================== 使用说明 ====================
# 1. 复制本文件为同目录下的 application.properties
#    cp application.properties.example application.properties
# 2. 按本地环境填写各项真实值；application.properties 已被 .gitignore 忽略，不会被提交
# 3. 生产环境建议改用环境变量覆盖（优先级高于本文件）：
#    DB_URL / DB_USERNAME / DB_PASSWORD / JWT_ACCESS_SECRET / JWT_REFRESH_SECRET
#    SMTP_HOST / SMTP_PORT / SMTP_USER / SMTP_PASSWORD
#    STORAGE_TOMCAT_PATH / STORAGE_PROJECT_PATH / FFMPEG_PATH / HLS_ROOT_DIR / CORS_ALLOWED_ORIGINS

# ==================== 数据库配置 ====================
db.url=jdbc:mysql://127.0.0.1:3306/lvdong_music_db
db.username=root
db.password=your_mysql_password

# ==================== JWT配置 ====================
# 生成强密钥：openssl rand -hex 32
# 注意：jjwt 0.9.1 会按 Base64 解码密钥，值必须只包含 Base64 字符集（A-Za-z0-9+/=），
#      含下划线等字符会导致签名失败。下面的占位值可直接启动，但请务必替换为你自己的密钥。
jwt.access.secret=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
jwt.refresh.secret=BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB
# 30 分钟
jwt.access.expire=1800000
# 7 天
jwt.refresh.expire=604800000

# ==================== 邮件配置（邮箱验证码 / 找回密码）====================
smtp.host=smtp.qq.com
smtp.port=465
smtp.user=your_email@qq.com
smtp.password=your_smtp_auth_code

# ==================== 文件存储配置 ====================
# Tomcat 部署目录（歌曲、封面等静态资源）
storage.tomcat.path=D:/Service/xgxmusic/
# 项目源码目录下的 webapp 路径
storage.project.path=D:/Java/JavaWeb/ListenToMusic/src/main/webapp/

# ==================== FFmpeg配置（HLS 流媒体转码）====================
ffmpeg.path=D:/ffmpeg-master-latest-win64-gpl-shared/bin/ffmpeg.exe
hls.root.dir=D:/Service/xgxmusic/hls

# ==================== CORS配置 ====================
# 允许的跨域来源，逗号分隔
cors.allowed.origins=http://localhost:8080,http://localhost:8081

# ==================== 讯飞哼唱识别（可选，使用 utils/hummingEcognition/qbh 时需要）====================
qbh.appid=
qbh.api.key=
