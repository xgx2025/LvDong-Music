# 复制为同目录下的 .env 后填写真实值；.env 仅保留本地，不会打入 JAR。
# 从仓库根目录或 backend 目录启动均可自动加载；系统环境变量优先。
# 按 Java properties 的 KEY=value 格式填写，不加引号，不使用 export。
# 注释单独一行；值中的反斜杠需写成两个反斜杠。

# HTTP 端口
PORT=8081

# MySQL 连接；数据库应已具有业务表，服务不会自动建表。
DB_URL=jdbc:mysql://127.0.0.1:3306/lvdong_music_db?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=change_me

# 邮箱验证码；不填写真实凭证时发送接口会返回失败。
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=true
SMTP_STARTTLS=false

# 独立新文件目录；与旧站源码、部署目录分开。路径推荐使用正斜杠。
STORAGE_ROOT=
# 旧图片和歌词根目录（应含static子目录），只读使用。
LEGACY_STORAGE_ROOT=
# 旧音频目录；与静态资源不在同一目录时单独配置，不设置则沿用LEGACY_STORAGE_ROOT。
LEGACY_AUDIO_ROOT=
# 完成校验后的旧资源副本，内部含assets/static和audio；优先读取，缺失时回退旧目录。
LEGACY_MIRROR_ROOT=
# 新HLS输出目录，请使用全新目录，不指向旧站转换目录。
HLS_ROOT_DIR=
FFMPEG_PATH=ffmpeg

# 星火HTTP识曲，凭证只填写APIPassword，不含Bearer前缀。
RECOGNITION_ENDPOINT=https://spark-api-open.xf-yun.com/v1/chat/completions
RECOGNITION_API_KEY=
RECOGNITION_MODEL=4.0Ultra
