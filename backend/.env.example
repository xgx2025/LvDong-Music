# 复制为同目录下的 .env 后填写真实值；.env 仅保留本地，不会打入 JAR。
# 从仓库根目录或 backend 目录启动均可自动加载；系统环境变量优先。
# 按 Java properties 的 KEY=value 格式填写，不加引号，不使用 export。
# 注释单独一行；值中的反斜杠需写成两个反斜杠。

# HTTP 端口
PORT=8081

# MySQL 连接；数据库应已具有业务表，服务不会自动建表。
DB_URL=jdbc:mysql://127.0.0.1:3306/lvdong_music_db?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=change_me
